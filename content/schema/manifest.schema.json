{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lorysvial24-jpg.github.io/dragoniq-studio/content/schema/manifest.schema.json",
  "title": "Fortnite Meta — manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "updated_at", "min_app_build", "default_language", "languages", "files"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "content_version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "min_app_build": { "type": "integer", "minimum": 1 },
    "default_language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "label"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2}(-[A-Za-z0-9]{2,8})?$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": { "content": { "type": "string", "minLength": 1 } }
    }
  }
}
